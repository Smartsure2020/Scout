{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scout-smartsure-ux-qa",
  "main": "scout-smartsure/qa-preview-worker.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "scout-smartsure",
    "binding": "ASSETS",
    "run_worker_first": ["/claims/qa-preview-config.js"]
  },
  "vars": {
    "SCOUT_QA_FIXTURE_MODE": "true",
    "SCOUT_BASE_URL": "https://scout-smartsure-ux-qa.marketing-854.workers.dev/claims/"
  }
}
